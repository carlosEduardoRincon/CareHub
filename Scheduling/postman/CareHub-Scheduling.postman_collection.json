{
  "info": {
    "_postman_id": "f7a1b5b4-1234-4abc-9def-111122223333",
    "name": "CareHub Scheduling API",
    "description": "Coleção Postman unificada com autenticação JWT e rotas de Doctors, Patients, Nurses e Schedules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "jwt", "value": "" },
    { "key": "doctorId", "value": "1" },
    { "key": "patientId", "value": "1" },
    { "key": "nurseId", "value": "1" },
    { "key": "scheduleId", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"\",\n  \"password\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  try {",
              "    const json = pm.response.json();",
              "    if (json && json.token) {",
              "      pm.collectionVariables.set('jwt', json.token);",
              "      console.log('JWT salvo em collectionVariables.jwt');",
              "    }",
              "  } catch (e) {",
              "    console.warn('Falha ao ler token da resposta:', e);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Create Doctor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. John Doe\",\n  \"email\": \"john.doe@carehub.com\",\n  \"login\": \"jdoe\",\n  \"password\": \"secret123\",\n  \"cpf\": \"12345678900\",\n  \"crm\": \"CRM-12345\",\n  \"speciality\": \"CARDIOLOGY\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/doctors",
              "host": ["{{baseUrl}}"],
              "path": ["doctors"]
            }
          }
        },
        {
          "name": "Get Doctor by Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}"]
            }
          }
        },
        {
          "name": "List Doctors (paginated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/doctors?page=0&perPage=10",
              "host": ["{{baseUrl}}"],
              "path": ["doctors"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "perPage", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Update Doctor",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. John Updated\",\n  \"email\": \"john.updated@carehub.com\",\n  \"speciality\": \"DERMATOLOGY\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}"]
            }
          }
        },
        {
          "name": "Delete Doctor",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}"]
            }
          }
        }
      ]
