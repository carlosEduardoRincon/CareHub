type Query {
  historyByPatient(patientId: ID!, onlyFuture: Boolean = false): [HistoryRecord!]!
}

type Mutation {
  editHistoryRecord(input: EditHistoryRecordInput!): HistoryRecord!
}

type HistoryRecord {
  historyId: ID!
  patientId: ID!
  scheduleId: ID
  doctorId: ID
  eventType: String
  eventTime: String
  payload: String
  createdAt: String
}

input EditHistoryRecordInput {
  historyId: ID!
  eventType: String
  eventTime: String
  scheduleId: ID
}
