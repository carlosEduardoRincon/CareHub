			"name": "History - Query by patient (all)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"const json = pm.response.json();",
							"pm.test(\"No GraphQL errors\", function () {",
							"  pm.expect(json.errors).to.be.undefined;",
							"});",
							"pm.test(\"Data.historyByPatient is array\", function () {",
							"  pm.expect(json.data).to.have.property('historyByPatient');",
							"  pm.expect(json.data.historyByPatient).to.be.an('array');",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
