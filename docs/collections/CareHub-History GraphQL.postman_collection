				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{jwtToken}}"
					}
				],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "query HistoryByPatient($patientId: ID!, $onlyFuture: Boolean) {  \r\n    historyByPatient(patientId: $patientId, onlyFuture: $onlyFuture) {\r\n        patientId\r\n        scheduleId\r\n        doctorId\r\n        eventType\r\n        eventTime\r\n        payload\r\n        createdAt\r\n    }\r\n}",
						"variables": "{  \r\n    \"patientId\": 1,  \r\n    \"onlyFuture\": false\r\n}"
					}
